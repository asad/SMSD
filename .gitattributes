# Text files are stored and checked out with LF line endings on every platform.
# Windows batch files are stored with the CRLF line endings that cmd.exe needs and
# are never converted, so every checkout and the source archive hold the same bytes.
* text=auto eol=lf
*.bat -text
*.cmd -text

# Binary files are never converted.
*.docx binary
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.jar binary
*.gz binary
*.zip binary

# Preserve the upstream third-party license text verbatim.
licenses/libomp/LICENSE.TXT whitespace=-blank-at-eof
licenses/beam/LICENSE whitespace=-trailing-space
